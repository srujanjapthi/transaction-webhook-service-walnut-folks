          "name": "Create Transaction - Standard INR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"{{transactionId}}\",\n  \"source_account\": \"ACC001\",\n  \"destination_account\": \"ACC002\",\n  \"amount\": 1500.50,\n  \"currency\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/webhooks/transactions"
